{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug main: static A",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/bin/main.out",
            "args": ["${workspaceFolder}/build/debug/config/impl_a_static.yaml"],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Interfacing: build debug",
            "stopAtEntry": true,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/opt/rh/devtoolset-9/root/usr/bin/gdb",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/install/lib:${workspaceFolder}/build/debug/lib"
                }
            ],
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true },
                { "text": "-gdb-set breakpoint pending on", "ignoreFailures": true }
            ],
            "logging": { "engineLogging": true }
        },
        {
            "name": "Debug main: dynamic A",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/bin/main.out",
            "args": ["${workspaceFolder}/build/debug/config/impl_a_dynamic.yaml"],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Interfacing: build debug",
            "stopAtEntry": true,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/opt/rh/devtoolset-9/root/usr/bin/gdb",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/install/lib:${workspaceFolder}/build/debug/lib"
                }
            ],
            "additionalSOLibSearchPath": "${workspaceFolder}/build/debug/lib;${workspaceFolder}/install/lib",
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true },
                { "text": "-gdb-set breakpoint pending on", "ignoreFailures": true }
            ],
            "logging": { "engineLogging": true }
        },
        {
            "name": "Debug test: static A",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/bin/interfacing_tests",
            "args": [
                "--gtest_filter=StaticLoading.LoadsImplementationAAndReportsStaticMode",
                "--gtest_break_on_failure",
                "--gtest_catch_exceptions=0"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Interfacing: build debug",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/opt/rh/devtoolset-9/root/usr/bin/gdb",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/install/lib:${workspaceFolder}/build/debug/lib"
                }
            ],
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true },
                { "text": "-gdb-set breakpoint pending on", "ignoreFailures": true }
            ],
            "logging": { "engineLogging": true }
        },
        {
            "name": "Debug test: dynamic A",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/bin/interfacing_tests",
            "args": [
                "--gtest_filter=DynamicLoading.LoadsImplementationAAndReportsDynamicMode",
                "--gtest_break_on_failure",
                "--gtest_catch_exceptions=0"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Interfacing: build debug",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/opt/rh/devtoolset-9/root/usr/bin/gdb",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/install/lib:${workspaceFolder}/build/debug/lib"
                }
            ],
            "additionalSOLibSearchPath": "${workspaceFolder}/build/debug/lib;${workspaceFolder}/install/lib",
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true },
                { "text": "-gdb-set breakpoint pending on", "ignoreFailures": true }
            ],
            "logging": { "engineLogging": true }
        }
    ]
}
