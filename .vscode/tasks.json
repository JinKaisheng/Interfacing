{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Interfacing: dependencies",
            "type": "shell",
            "command": "bash",
            "args": [
                "compile.sh",
                "deps"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Interfacing: build debug",
            "type": "shell",
            "command": "bash",
            "args": [
                "compile.sh",
                "debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Interfacing: test debug",
            "type": "shell",
            "command": "bash",
            "args": [
                "compile.sh",
                "debug-test"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Interfacing: build debug",
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Interfacing: build advanced",
            "type": "shell",
            "command": "bash",
            "args": [
                "compile.sh",
                "advanced"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Interfacing: test advanced",
            "type": "shell",
            "command": "bash",
            "args": [
                "compile.sh",
                "advanced-test"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Interfacing: build advanced",
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Interfacing: verify all",
            "type": "shell",
            "command": "bash",
            "args": [
                ".agents/skills/interfacing-maintenance/scripts/verify.sh"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Interfacing: run static A",
            "type": "shell",
            "command": "${workspaceFolder}/build/debug/bin/main.out",
            "args": [
                "${workspaceFolder}/build/debug/config/impl_a_static.yaml"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Interfacing: build debug",
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Interfacing: run dynamic A",
            "type": "shell",
            "command": "${workspaceFolder}/build/debug/bin/main.out",
            "args": [
                "${workspaceFolder}/build/debug/config/impl_a_dynamic.yaml"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Interfacing: build debug",
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}
